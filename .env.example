# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/link
# 32 random bytes, base64. Encrypts Plaid access tokens and signs dev sessions.
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
LINK_ENCRYPTION_KEY=
# Public origin, used for Plaid webhooks (https://your-domain)
LINK_PUBLIC_URL=

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local development only, refused when NODE_ENV=production:
# LINK_DEV_AUTH=1

# ── Plaid ───────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production

# ── AI (OpenAI Responses API) ───────────────────────────────────────────────
OPENAI_API_KEY=
LINK_AI_MODEL=gpt-6-luna      # GPT-6 Luna
LINK_AI_REASONING_EFFORT=low  # none | minimal | low | medium | high | xhigh | max
# LINK_AI_DISABLED=1          # force the deterministic planner

# ── Jobs ────────────────────────────────────────────────────────────────────
CRON_SECRET=                  # sent by the scheduler as "Authorization: Bearer <secret>"
